@startuml

title Smart Campus Parking, LPR, and EV Network - ECB Class Diagram

' Parameter types, return types and controller multiplicities
' are design choices inferred from the system story.
' Rendering has not been tested.

' =========================
' ENUMERATIONS
' =========================

enum UserRole {
    STUDENT
    FACULTY
    SECURITY_GUARD
    TRAFFIC_ADMIN
}

enum SpotStatus {
    AVAILABLE
    RESERVED
    OCCUPIED
}

enum ReservationStatus {
    ACTIVE
    FULFILLED
    NO_SHOW_REVOKED
}

enum AppealDecision {
    PENDING
    APPROVED
    REJECTED
}

' =========================
' BOUNDARY CLASSES
' =========================

class StudentDashboardUI <<boundary>> {
    - selectedZone : ParkingZone
    + displayAvailableSpots(spots : List<ParkingSpot>) : void
    + onReserveSpotClicked(spotId : String, licensePlate : String) : void
    + onSubmitAppealClicked(violationId : String, reasonText : String, evidence : String) : void
    + displayCountdown(minutes : int) : void
    + showErrorAlert(message : String) : void
}

class GuardTerminalUI <<boundary>> {
    + onLogViolationClicked(licensePlate : String, reason : String) : void
    + onIssueGuestQrClicked(guestPlate : String) : void
}

class AdminAppealUI <<boundary>> {
    + onReviewAppealClicked(appealId : String, decision : AppealDecision) : void
}

class LprGateBoundary <<boundary>> {
    + onPlateScanned(licensePlate : String, zoneName : String) : void
    + onGuestQrScanned(qrToken : String) : void
    + openBarrierGate() : void
    + denyEntry() : void
}

class PaymentGatewayBoundary <<boundary>> {
    + authorizeCreditCard(amount : double) : PaymentAuthorization
}

class SmsGatewayBoundary <<boundary>> {
    + sendSmsAlert(phoneNumber : String, message : String) : void
}

' =========================
' CONTROL CLASSES
' =========================

class ReservationControl <<control>> {
    - reservationWindowMin : int = 15
    + findAvailableSpots(userId : String, zoneId : String) : List<ParkingSpot>
    + reserveSpot(userId : String, spotId : String, licensePlate : String) : Reservation
    + processLprGateEntry(licensePlate : String, zoneName : String) : void
    + validateGuestQrEntry(qrToken : String) : boolean
    + revokeExpiredReservations() : void
}

class EvBillingControl <<control>> {
    - idleGraceMin : int = 30
    - idleRateNisPerHour : double = 5.0
    + authorizeEvPayment(reservationId : String, amount : double) : PaymentAuthorization
    + notifyChargeComplete(sessionId : String) : void
    + applyIdlePenalties() : void
}

class EnforcementControl <<control>> {
    + issueGuestPass(guestPlate : String) : GuestPass
    + logSevereViolation(licensePlate : String, reason : String) : Violation
    + submitDigitalAppeal(violationId : String, reasonText : String, evidence : String) : Appeal
    + reviewDigitalAppeal(appealId : String, decision : AppealDecision) : void
}

' =========================
' ENTITY CLASSES
' =========================

abstract class User <<entity>> {
    - userId : String
    - fullName : String
    - email : String
    - phoneNumber : String
    - role : UserRole
    - noShowWarnings : int
    + incrementNoShowWarnings() : void
}

class Student <<entity>> {
    - studentId : String
    - activePermit : boolean
    + hasActivePermit() : boolean
}

class Faculty <<entity>> {
    - facultyId : String
    - department : String
    - activePermit : boolean
    + hasActivePermit() : boolean
}

class SecurityGuard <<entity>> {
    - badgeNumber : String
}

class TrafficAdministrator <<entity>> {
    - adminOfficeId : String
}

class GuestPass <<entity>> {
    - qrToken : String
    - guestPlate : String
    - expiresAt : LocalDateTime
    - isUsed : boolean
    + isValid() : boolean
    + markUsed() : void
}

class Vehicle <<entity>> {
    - licensePlate : String
}

class ParkingZone <<entity>> {
    - zoneId : String
    - zoneName : String
    - totalCapacity : int
}

class ParkingSpot <<entity>> {
    - spotId : String
    - isEvCharger : boolean
    - status : SpotStatus
    - version : int
    + isAvailable() : boolean
    + tryReserve(expectedVersion : int) : boolean
    + setStatus(status : SpotStatus) : void
}
note right of ParkingSpot
    tryReserve(expectedVersion) is atomic.

    Reservation succeeds only if:
    - status == AVAILABLE
    - version == expectedVersion

    On success:
    - status = RESERVED
    - version = version + 1

    Otherwise, return false.
end note

class Reservation <<entity>> {
    - reservationId : String
    - createdAt : LocalDateTime
    - expiresAt : LocalDateTime
    - status : ReservationStatus
    + isWithin15MinWindow() : boolean
    + setStatus(status : ReservationStatus) : void
}

class PaymentAuthorization <<entity>> {
    - authId : String
    - gatewayToken : String
    - authorizedAmount : double
    - authorizedAt : LocalDateTime
}

class ChargingSession <<entity>> {
    - sessionId : String
    - completedAt : LocalDateTime
    - isPluggedIn : boolean
    - isPhysicallyOccupied : boolean
    - idlePenaltyNis : double
    + isIdleOver30Minutes() : boolean
    + setPluggedIn(pluggedIn : boolean) : void
    + setPhysicallyOccupied(occupied : boolean) : void
}

note right of ChargingSession
    Electrical connection and physical
    occupancy are independent states.

    The idle penalty starts after the
    30-minute grace period if the vehicle
    still occupies the parking spot.

    Disconnecting the cable does not
    prevent or stop the idle penalty.
end note

class Violation <<entity>> {
    - violationId : String
    - reason : String
    - fineAmount : double
    - isPaid : boolean
    + cancelFine() : void
}

class Appeal <<entity>> {
    - appealId : String
    - reasonText : String
    - decision : AppealDecision
    + setDecision(decision : AppealDecision) : void
}

' =========================
' INHERITANCE
' =========================

User <|-- Student
User <|-- Faculty
User <|-- SecurityGuard
User <|-- TrafficAdministrator

' =========================
' AGGREGATION
' =========================

ParkingZone "1" o-- "1..*" ParkingSpot : contains

' =========================
' COMPOSITION
' =========================

Reservation "1" *-- "0..1" PaymentAuthorization : requires for EV
Reservation "1" *-- "0..1" ChargingSession : initiates
Violation "1" *-- "0..1" Appeal : contested by

' =========================
' ENTITY ASSOCIATIONS
' =========================

User "1" -- "0..*" Vehicle : owns
Vehicle "1" -- "0..*" Reservation : booked for
ParkingSpot "1" -- "0..*" Reservation : assigned to
Vehicle "1" -- "0..*" Violation : receives
SecurityGuard "0..1" -- "0..*" Violation : logs
SecurityGuard "1" -- "0..*" GuestPass : issues
TrafficAdministrator "0..1" -- "0..*" Appeal : reviews

' =========================
' BOUNDARY-CONTROL ASSOCIATIONS
' =========================

StudentDashboardUI "0..*" -- "1" ReservationControl : requests reservations
StudentDashboardUI "0..*" -- "1" EnforcementControl : submits appeals

GuardTerminalUI "0..*" -- "1" EnforcementControl : logs violations and requests passes

AdminAppealUI "0..*" -- "1" EnforcementControl : reviews appeals

LprGateBoundary "0..*" -- "1" ReservationControl : processes gate entry

PaymentGatewayBoundary "1" -- "1" EvBillingControl : authorizes payments

SmsGatewayBoundary "1" -- "1" EvBillingControl : sends charging alerts
SmsGatewayBoundary "1" -- "1" EnforcementControl : sends violation alerts

' =========================
' RESERVATION CONTROL-ENTITY ASSOCIATIONS
' =========================

ReservationControl "1" -- "0..*" User : validates users
ReservationControl "1" -- "0..*" Vehicle : identifies vehicles
ReservationControl "1" -- "0..*" ParkingZone : filters zones
ReservationControl "1" -- "0..*" ParkingSpot : manages availability
ReservationControl "1" -- "0..*" Reservation : manages reservations
ReservationControl "1" -- "0..*" GuestPass : validates guest passes

' =========================
' EV BILLING CONTROL-ENTITY ASSOCIATIONS
' =========================

EvBillingControl "1" -- "0..*" PaymentAuthorization : manages authorizations
EvBillingControl "1" -- "0..*" ChargingSession : monitors charging
EvBillingControl "1" -- "0..*" Violation : creates idle penalties

' =========================
' ENFORCEMENT CONTROL-ENTITY ASSOCIATIONS
' =========================

EnforcementControl "1" -- "0..*" Vehicle : identifies violating vehicles
EnforcementControl "1" -- "0..*" GuestPass : generates guest passes
EnforcementControl "1" -- "0..*" Violation : manages violations
EnforcementControl "1" -- "0..*" Appeal : processes appeals

@enduml