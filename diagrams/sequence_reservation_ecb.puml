
@startuml

title Spot Reservation, LPR Gate Entry & No-Show Destruction

actor Student
boundary ":StudentDashboardUI" as UI
control ":ReservationControl" as Ctrl
entity "spot : ParkingSpot" as Spot
entity "res : Reservation" as Res
boundary ":LprGateBoundary" as LPR

Student -> UI : onReserveSpotClicked("EV-04", "12-345-67")
activate UI

UI -> Ctrl : reserveSpot(userId, "EV-04", "12-345-67")
activate Ctrl

Ctrl -> Spot : isAvailable()
activate Spot
Spot --> Ctrl : available
deactivate Spot

alt available == true

    Ctrl -> Spot : tryReserve(expectedVersion)
    note right of Spot
        Atomic version check and
        reservation status update.
        Only one request can succeed.
    end note
    activate Spot
    Spot --> Ctrl : acquired
    deactivate Spot

    alt acquired == true

        create Res
        Ctrl -> Res : <<create>>
        activate Res
        Res --> Ctrl : res
        deactivate Res

        Ctrl --> UI : res
        UI -> UI : displayCountdown(15)

    else Concurrent Race Condition

        Ctrl --> UI : null
        UI -> UI : showErrorAlert("Spot just reserved by another user")

    end

else available == false

    Ctrl --> UI : null
    UI -> UI : showErrorAlert("Spot unavailable")

end

deactivate Ctrl
deactivate UI

== Within 15 Minutes: Vehicle Arrives at Entrance Gate ==

opt Reservation successfully created

    LPR -> Ctrl : processLprGateEntry("12-345-67", "EV Zone")
    activate Ctrl

    Ctrl -> Res : isWithin15MinWindow()
    activate Res
    Res --> Ctrl : valid
    deactivate Res

    alt valid == true

        Ctrl -> Res : setStatus(FULFILLED)
        activate Res
        deactivate Res

        Ctrl -> LPR : openBarrierGate()
        activate LPR
        deactivate LPR

    else No-Show > 15 Min

        Ctrl -> Res : setStatus(NO_SHOW_REVOKED)
        activate Res
        deactivate Res

        destroy Res

        Ctrl -> LPR : denyEntry()
        activate LPR
        deactivate LPR

    end

    deactivate Ctrl

end

@enduml
